# Use Me With Style environment template
#
# Copy this file to an untracked local file when needed:
# - .env.development.local
# - .env.staging.local
# - .env.production.local
#
# Never commit real secrets. Public browser variables must use the VITE_ prefix.

# Public frontend config
VITE_APP_ENV=development
VITE_APP_NAME="Use Me With Style"
VITE_SITE_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:4000
VITE_CMS_URL=http://localhost:3000/admin
VITE_DEFAULT_MARKET=AO
VITE_PAYMENT_MODE=sandbox
# Public PayPal client ID (JOS-61) -- safe to expose client-side, loads the
# PayPal JS SDK button. The matching secret lives server-side only, in
# use-me-with-style-cms's own env (never here).
VITE_PAYPAL_CLIENT_ID=
# Public values consumed by AppyPay's hosted Charges Widget. AppyPay provides
# these after merchant activation. The merchant name must be the registered
# legal designation. Do not put the server client secret in this frontend.
VITE_APPYPAY_WIDGET_API_KEY=
VITE_APPYPAY_WIDGET_CLIENT_ID=
VITE_APPYPAY_MERCHANT_NAME=
VITE_APPYPAY_WIDGET_SRC=https://widget.appypay.co.ao/main.js
# AppyPay's async callback. Configure the same URL and Basic credentials in
# the merchant portal. Replace with the final API domain after handoff.
VITE_APPYPAY_REDIRECT_URI=https://use-me-with-style-cms-production.up.railway.app/api/payments/appypay/webhook
VITE_APPYPAY_PAYMENT_METHODS=
VITE_ENABLE_LIVE_PAYMENTS=false
VITE_ENABLE_MESSAGING_AUTOMATION=false
VITE_ENABLE_ANALYTICS=false
# Public Meta dataset/pixel identifier. Tracking still remains disabled until
# VITE_ENABLE_ANALYTICS=true and the visitor accepts analytics cookies.
VITE_META_PIXEL_ID=2812919002423451

# Backend/API/CMS config
API_PORT=4000
CMS_PORT=3000
DATABASE_URL=
DIRECT_DATABASE_URL=
PAYLOAD_SECRET=
PAYLOAD_PUBLIC_SERVER_URL=

# Media storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
MBWAY_MERCHANT_ID=
MBWAY_API_KEY=
APPY_PAY_CLIENT_ID=
APPY_PAY_CLIENT_SECRET=
APPY_PAY_WEBHOOK_SECRET=
MULTICAIXA_MERCHANT_ID=
MULTICAIXA_API_KEY=

# Messaging and social integrations
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
META_PIXEL_ID=
META_ACCESS_TOKEN=
