# Use Me With Style environment template
#
# Copy this file to an untracked local file when needed:
# - .env.development.local
# - .env.staging.local
# - .env.production.local
#
# Never commit real secrets. Public browser variables must use the VITE_ prefix.

# Public frontend config
VITE_APP_ENV=development
VITE_APP_NAME="Use Me With Style"
VITE_SITE_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:4000
VITE_CMS_URL=http://localhost:3000/admin
VITE_DEFAULT_MARKET=AO
VITE_PAYMENT_MODE=sandbox
VITE_ENABLE_MOCK_DATA=true
VITE_ENABLE_LIVE_PAYMENTS=false
VITE_ENABLE_MESSAGING_AUTOMATION=false
VITE_ENABLE_ANALYTICS=false

# Backend/API/CMS config
API_PORT=4000
CMS_PORT=3000
DATABASE_URL=
DIRECT_DATABASE_URL=
PAYLOAD_SECRET=
PAYLOAD_PUBLIC_SERVER_URL=

# Media storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
MBWAY_MERCHANT_ID=
MBWAY_API_KEY=
APPY_PAY_CLIENT_ID=
APPY_PAY_CLIENT_SECRET=
APPY_PAY_WEBHOOK_SECRET=
MULTICAIXA_MERCHANT_ID=
MULTICAIXA_API_KEY=

# Messaging and social integrations
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
META_PIXEL_ID=
META_ACCESS_TOKEN=
