{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://use-me-with-style-cms-production.up.railway.app/api/:path*"
    },
    {
      "source": "/robots.txt",
      "has": [{ "type": "host", "value": "ao.usemewithstyle.shop" }],
      "destination": "https://use-me-with-style-cms-production.up.railway.app/api/robots.txt?market=AO"
    },
    {
      "source": "/sitemap.xml",
      "has": [{ "type": "host", "value": "ao.usemewithstyle.shop" }],
      "destination": "https://use-me-with-style-cms-production.up.railway.app/api/sitemap.xml?market=AO"
    },
    {
      "source": "/robots.txt",
      "has": [{ "type": "host", "value": "pt.usemewithstyle.shop" }],
      "destination": "https://use-me-with-style-cms-production.up.railway.app/api/robots.txt?market=PT"
    },
    {
      "source": "/sitemap.xml",
      "has": [{ "type": "host", "value": "pt.usemewithstyle.shop" }],
      "destination": "https://use-me-with-style-cms-production.up.railway.app/api/sitemap.xml?market=PT"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "ao.usemewithstyle.shop" }],
      "destination": "/__prerender/ao/index.html"
    },
    {
      "source": "/catalogo",
      "has": [
        { "type": "host", "value": "ao.usemewithstyle.shop" },
        { "type": "query", "key": "cat", "value": "(?<category>[a-z0-9]+(?:-[a-z0-9]+)*)" }
      ],
      "destination": "/__prerender/ao/catalogo/category/:category/index.html"
    },
    {
      "source": "/:page(catalogo|ajuda|perguntas-frequentes|guia-de-tamanhos|sobre|estilo|shop-instagram|politica-privacidade|termos-condicoes|eliminacao-de-dados)",
      "has": [{ "type": "host", "value": "ao.usemewithstyle.shop" }],
      "destination": "/__prerender/ao/:page/index.html"
    },
    {
      "source": "/produto/:slug",
      "has": [{ "type": "host", "value": "ao.usemewithstyle.shop" }],
      "destination": "/__prerender/ao/produto/:slug/index.html"
    },
    {
      "source": "/estilo/:slug",
      "has": [{ "type": "host", "value": "ao.usemewithstyle.shop" }],
      "destination": "/__prerender/ao/estilo/:slug/index.html"
    },
    {
      "source": "/shop-instagram/:slug",
      "has": [{ "type": "host", "value": "ao.usemewithstyle.shop" }],
      "destination": "/__prerender/ao/shop-instagram/:slug/index.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "pt.usemewithstyle.shop" }],
      "destination": "/__prerender/pt/index.html"
    },
    {
      "source": "/catalogo",
      "has": [
        { "type": "host", "value": "pt.usemewithstyle.shop" },
        { "type": "query", "key": "cat", "value": "(?<category>[a-z0-9]+(?:-[a-z0-9]+)*)" }
      ],
      "destination": "/__prerender/pt/catalogo/category/:category/index.html"
    },
    {
      "source": "/:page(catalogo|ajuda|perguntas-frequentes|guia-de-tamanhos|sobre|estilo|shop-instagram|politica-privacidade|termos-condicoes|eliminacao-de-dados)",
      "has": [{ "type": "host", "value": "pt.usemewithstyle.shop" }],
      "destination": "/__prerender/pt/:page/index.html"
    },
    {
      "source": "/produto/:slug",
      "has": [{ "type": "host", "value": "pt.usemewithstyle.shop" }],
      "destination": "/__prerender/pt/produto/:slug/index.html"
    },
    {
      "source": "/estilo/:slug",
      "has": [{ "type": "host", "value": "pt.usemewithstyle.shop" }],
      "destination": "/__prerender/pt/estilo/:slug/index.html"
    },
    {
      "source": "/shop-instagram/:slug",
      "has": [{ "type": "host", "value": "pt.usemewithstyle.shop" }],
      "destination": "/__prerender/pt/shop-instagram/:slug/index.html"
    },
    {
      "source": "/:page(carrinho|checkout|conta)",
      "destination": "/__spa.html"
    },
    {
      "source": "/encomenda-confirmada/:orderNumber",
      "destination": "/__spa.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/__spa.html"
    },
    {
      "source": "/",
      "missing": [
        { "type": "host", "value": "ao.usemewithstyle.shop" },
        { "type": "host", "value": "pt.usemewithstyle.shop" }
      ],
      "destination": "/__spa.html"
    },
    {
      "source": "/:page(catalogo|ajuda|perguntas-frequentes|guia-de-tamanhos|sobre|estilo|shop-instagram|politica-privacidade|termos-condicoes|eliminacao-de-dados)",
      "missing": [
        { "type": "host", "value": "ao.usemewithstyle.shop" },
        { "type": "host", "value": "pt.usemewithstyle.shop" }
      ],
      "destination": "/__spa.html"
    },
    {
      "source": "/produto/:slug",
      "missing": [
        { "type": "host", "value": "ao.usemewithstyle.shop" },
        { "type": "host", "value": "pt.usemewithstyle.shop" }
      ],
      "destination": "/__spa.html"
    },
    {
      "source": "/estilo/:slug",
      "missing": [
        { "type": "host", "value": "ao.usemewithstyle.shop" },
        { "type": "host", "value": "pt.usemewithstyle.shop" }
      ],
      "destination": "/__spa.html"
    },
    {
      "source": "/shop-instagram/:slug",
      "missing": [
        { "type": "host", "value": "ao.usemewithstyle.shop" },
        { "type": "host", "value": "pt.usemewithstyle.shop" }
      ],
      "destination": "/__spa.html"
    }
  ]
}
