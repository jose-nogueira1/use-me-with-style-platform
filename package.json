{
  "name": "use-me-with-style-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:staging": "vite --mode staging",
    "build": "VITE_API_BASE_URL=/ vite build && node scripts/prerender.mjs && node scripts/verify-prerender.mjs",
    "build:spa": "vite build",
    "build:staging": "vite build --mode staging",
    "build:production": "vite build --mode production",
    "env:check": "node scripts/check-env.mjs development",
    "env:check:staging": "node scripts/check-env.mjs staging",
    "env:check:production": "node scripts/check-env.mjs production",
    "domain:check": "node scripts/check-production-domains.mjs",
    "export:storefront-screenshots": "node scripts/export-storefront-screenshots.mjs",
    "export:admin-screenshots": "node scripts/export-admin-screenshots.mjs",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:prerender": "node scripts/verify-prerender.mjs",
    "preview": "npm run preview:prerender",
    "preview:prerender": "node scripts/serve-prerender.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "browser-image-compression": "^2.0.2",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-easy-crop": "^6.2.3",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@sparticuz/chromium": "^149.0.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5"
  }
}
